+_IK_PAIR_RE = re.compile(r"Left object: (\S+)\s+Right objects?: (\S+)")
+
+
+def ik_collision_blocker(ctx: SkillContext, pos, rot, q_seed, cs, n: int = 4) -> str:
+    """Intrinsic's verdict on a candidate tcp pose: "" when ComputeIk (collision checked with `cs`,
+    attached objects included) returns a solution; otherwise the first colliding pair reported
+    by Intrinsic ("hand:microwave_1_main" style) or "ik:unreachable" when no solution exists at
+    all. Used to confirm a release pose that the adapter's box model accepted (task 9: the box
+    model accepted hand poses inside the microwave that Intrinsic's mesh check rejects)."""
+    try:
+        sols, _, _ = ctx.client.ik(pos, rot, q_seed, max_solutions=n, collision_settings=cs)
+    except IntrinsicRequestError as e:
+        m = _IK_PAIR_RE.search(str(e))
+        if m:
+            a, b = m.group(1).replace("panda.", "").split(".")[0], m.group(2).split(".")[0]
+            return f"{a}:{b}"
+        return "ik:" + ("unreachable" if "NOT_FOUND" in str(e) else str(e)[:40])
+    return "" if sols else "ik:unreachable"
+
+
